{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(pnpm test*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm -r test*)",
      "Bash(pnpm -r typecheck*)",
      "Bash(pnpm --filter * test*)",
      "Bash(pnpm --filter * typecheck*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(git switch -c *)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push -u origin feature/*)",
      "Bash(git push -u origin chore/*)",
      "Bash(git push origin feature/*)",
      "Bash(git push origin chore/*)",
      "Bash(gh pr list*)",
      "Bash(gh pr view*)",
      "Bash(gh pr checks*)"
    ],
    "ask": [
      "Bash(gh pr create*)",
      "Bash(pnpm add*)",
      "Bash(pnpm install *)",
      "Bash(*prisma migrate dev*)"
    ],
    "deny": [
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git push * HEAD:main*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard*)",
      "Bash(*prisma migrate reset*)",
      "Bash(gh pr merge*)",
      "mcp__github__merge_pull_request"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && git status -sb | head -5 && awk '/^## Needs your decision/||/^## Now/{f=1} /^## (Discovered|Done|Item format)/{f=0} f' BACKLOG.md"
          }
        ]
      }
    ]
  }
}
