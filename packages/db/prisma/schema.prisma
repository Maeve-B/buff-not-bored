// Persistence layer for Buff, Not Bored (Phase 4 — database foundation).
//
// This schema deliberately stores `workoutType`, `status`, `role` etc. as
// plain `String` columns rather than native Postgres enums, mirroring
// `packages/domain`'s own choice to keep those as extensible string unions
// (see entities/workout-type.ts's doc comment) rather than closed
// vocabularies. Adding a future workout type (Supersets, HIIT, ...) is then
// an application-level change (new value + validation), never a migration —
// so neither Circuit nor Classic Strength is structurally privileged as the
// database's "core" workout type.
//
// One `WorkoutExercise` -> many `WorkoutSet` models both existing session
// kinds uniformly: Circuit produces exactly one `WorkoutSet` per exercise
// (one prescription, one logged attempt); Classic Strength produces N. The
// schema doesn't need to know which — that distinction is an application
// concern, not a structural one.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// The exercise catalog — mirrors packages/domain's `Exercise` entity
/// field-for-field. Muscles/movement patterns are native Postgres arrays,
/// not join tables: nothing queries the database for muscle coverage today
/// (that's computed in-memory in packages/domain against static seed data),
/// so a join table here would be schema speculation, not a real need.
model Exercise {
  id                    String  @id
  name                  String
  programmeGroup        String
  primaryMuscles        String[]
  secondaryMuscles      String[]
  movementPatterns      String[]
  exerciseType          String
  equipment             String
  location               String
  startingWeight        Float?
  weightUnit            String?
  prescribedReps        Int?
  repsUnit              String?
  prescribedDuration    Float?
  progressionPercentage Float?
  active                Boolean @default(true)
  notes                 String?
  needsReview           Boolean @default(false)

  /// Library v2 profile (PRODUCT_SPEC.md v2 §9.1). Nullable / empty-list
  /// defaults only so rows saved before this column existed stay valid;
  /// every save from the current library fills them all (see
  /// mappers/exercise-mapper.ts).
  movementPattern            String?
  exerciseClass              String?
  skillLevel                 String?
  loadType                   String?
  equipmentNeeded            String[] @default([])
  station                    String?
  unilateral                 Boolean?
  perSide                    Boolean?
  incrementOptions           Float[]  @default([])
  loadDirection              String?
  progressionStrategyDefault String?
  lightAlternativeIds        String[] @default([])
  swapGroup                  String?
  regressionId               String?
  progressionId              String?
  jointStressTags            String[] @default([])
  cueSetup                   String?
  cueForm                    String[] @default([])

  workoutExercises WorkoutExercise[]
  capability       ExerciseCapability?
  weightLogs       ExerciseWeightLog[]

  @@map("exercises")
}

/// The user's current personal working ability for an exercise —
/// independent of any workout. A third, distinct concept from `Exercise`
/// (shared catalog/reference data, curated rarely) and from
/// `WorkoutExercise`/`WorkoutSet` (one session's recommendation and actual
/// performance, scoped to that session): this is "what do I currently
/// believe I can do," personal state that changes as the user gets
/// stronger and can exist even with zero workout history. See
/// packages/domain's entities/exercise-capability.ts for the full
/// rationale, including why `source` is never set automatically.
///
/// `exerciseId` is unique: exactly one current capability row per exercise
/// in this single-user MVP. Ready for multi-user by adding a `userId`
/// column and changing the unique constraint to `[userId, exerciseId]` —
/// not added now, since no auth/User model exists yet.
model ExerciseCapability {
  id         String   @id @default(cuid())
  exerciseId String   @unique
  exercise   Exercise @relation(fields: [exerciseId], references: [id])

  weight     Float?
  weightUnit String?
  reps       Int?
  repsUnit   String?
  duration   Float?

  /// "manual" | "progression" — plain string, same extensible-vocabulary convention as workoutType/role/status elsewhere in this schema.
  source String
  note   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("exercise_capabilities")
}

/// An append-only history of every weight the user has saved for an
/// exercise outside a workout — the history `ExerciseCapability`
/// deliberately doesn't keep. `ExerciseCapability` stays the single
/// "what I can do right now" row per exercise (upserted, overwritten on
/// every save); this table gets one NEW row per capability save that
/// includes a weight, written in the same transaction, and is never
/// updated or deleted. Kept as a separate table rather than relaxing
/// `ExerciseCapability.exerciseId @unique`, so the current-value contract
/// (and everything that reads it) is untouched.
///
/// Deliberately separate from workout-logged performance too
/// (`WorkoutSet.actualWeight`): that is "what I actually lifted in one
/// session", this is "what I recorded as my working weight". Both are
/// merged into one chronological timeline only at display time (see
/// apps/web/lib/actions/exercise-weight-history.ts) — never stored
/// together.
///
/// Weight only, by design: a reps-/duration-only capability save writes
/// nothing here. Same single-user scoping as ExerciseCapability — a future
/// multi-user change adds a `userId` column here too.
model ExerciseWeightLog {
  id         String   @id @default(cuid())
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id])

  weight     Float
  weightUnit String

  /// "manual" | "progression" — copied from the capability save that produced this entry; plain string, same extensible-vocabulary convention as ExerciseCapability.source.
  source String
  note   String?

  /// Set by the database at insert time — the entry's position in the timeline. Never caller-supplied, never updated.
  recordedAt DateTime @default(now())

  @@index([exerciseId, recordedAt])
  @@map("exercise_weight_logs")
}

/// A completed (or in-progress) workout/session — the shared envelope for
/// every workout type, matching packages/domain's `Workout` discriminated
/// union. `programmeId`/`weekNumber`/`scheduledWorkoutId` are the persisted
/// form of `WorkoutProgrammeContext` — nullable, since most workouts today
/// are built ad hoc, not from a scheduled programme. No `TrainingProgramme`
/// table exists yet: programmes remain code-defined seed data in
/// packages/domain for this phase (see req. 13 — don't persist what nothing
/// yet needs to query back out).
///
/// `id` is CLIENT-supplied (no @default) — a stable session id generated
/// once when the user starts a workout, not once per save. Every save for
/// that session (start, each logged set, completion) upserts the same row
/// by this id, which is the whole duplicate-prevention mechanism: there is
/// no way to produce two rows for one workout attempt, because there is
/// only ever one id for it.
model Workout {
  id                 String   @id
  workoutType        String
  name               String
  status             String
  /// Session-context date (spec convention — see domain WorkoutBase.dateIso), not a precise timestamp log.
  dateIso            DateTime @db.Date
  programmeId        String?
  weekNumber         Int?
  scheduledWorkoutId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  exercises WorkoutExercise[]

  @@map("workouts")
}

/// One exercise performed within a session. Carries the session's
/// `WeightRecommendation` for this exercise (base -> adjustments -> final) —
/// preserved distinctly from any set's actually-logged weight, which lives
/// on `WorkoutSet` below, never here.
model WorkoutExercise {
  id         String @id @default(cuid())
  workoutId  String
  workout    Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id])

  /// "main" | "finisher" (packages/domain SlotRole) — plain string for the same reason as workoutType above.
  role  String
  /// Explicit ordering: Prisma/Postgres don't otherwise guarantee row order matches the session's original sequence.
  order Int

  restSeconds Int?

  /// The recommendation's base weight — immutable once set. Absent for bodyweight-only exercises with no weight to recommend.
  baseWeight Float?
  /// Ordered list of WeightAdjustment (packages/domain), stored as-is: [{ type: "percentage", percent, reason? }, ...].
  adjustments Json?
  /// Always derived from baseWeight + adjustments at write time — never hand-set independently, matching packages/domain's applyWeightAdjustments.
  finalWeight Float?

  sets WorkoutSet[]

  @@unique([workoutId, order])
  @@map("workout_exercises")
}

/// One individual set performed. `target*` is the prescription (a snapshot,
/// per packages/domain's StrengthSet convention); `actual*` is what the user
/// actually logged — a completely separate value from `target*`, and from
/// the WorkoutExercise-level recommendation that produced the target.
model WorkoutSet {
  id                String          @id @default(cuid())
  workoutExerciseId String
  workoutExercise   WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)

  setNumber Int

  targetReps     Int?
  repsUnit       String?
  targetDuration Float?
  targetWeight   Float?

  actualWeight   Float?
  actualReps     Int?
  actualDuration Float?
  completed      Boolean   @default(false)
  loggedAt       DateTime?

  @@unique([workoutExerciseId, setNumber])
  @@map("workout_sets")
}
